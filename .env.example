APP_NAME="Kings' Kitchen"
APP_ENV=production
APP_KEY=
APP_DEBUG=false

# Set this after the first successful Vercel deployment.

# Example: https://kings-kitchen-api.vercel.app

APP_URL=

# Existing Kings' Kitchen frontend

FRONTEND_URL=https://kings-kishen.vercel.app

# --- Database: TiDB Cloud Starter ---

# Get these values from:

# TiDB Cloud → your cluster → Connect → General

DB_CONNECTION=mysql
DB_HOST=
DB_PORT=4000
DB_DATABASE=kingskitchen
DB_USERNAME=
DB_PASSWORD=

# TiDB Cloud requires TLS.

MYSQL_ATTR_SSL_CA=/etc/ssl/certs/ca-certificates.crt

# --- File storage: Vercel Blob ---

# Vercel automatically provides this when Blob storage is connected

# to the backend project.

BLOB_READ_WRITE_TOKEN=

# --- Application services ---

# The API uses Bearer-token authentication, so server-side sessions

# do not need persistent storage.

SESSION_DRIVER=array
CACHE_STORE=array
QUEUE_CONNECTION=sync
LOG_CHANNEL=stderr

# --- Mail ---

MAIL_MAILER=smtp
MAIL_HOST=mail.yourdomain.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="[orders@kingskitchen.example](mailto:orders@kingskitchen.example)"
MAIL_FROM_NAME="Kings' Kitchen"

# --- Paystack ---

# Add the REAL values only in Vercel Environment Variables.

# Never put live or test API keys in this file.

PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_PAYMENT_URL=https://api.paystack.co

# --- Laravel Sanctum ---

# Your existing frontend domain.

SANCTUM_STATEFUL_DOMAINS=kings-kishen.vercel.app
